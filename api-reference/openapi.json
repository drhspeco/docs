    "components": {
        "schemas": {
            "AlternativesRequest": {
                "type": "object",
                "properties": {
                    "product_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "query": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 5
                    }
                }
            },
            "CompareRequest": {
                "type": "object",
                "properties": {
                    "product_ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "maxItems": 5,
                        "minItems": 2
                    }
                },
                "required": [
                    "product_ids"
                ]
            },
            "CreateMcpApiKeyRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "rate_limit_per_minute": {
                        "type": "integer",
                        "maximum": 10000,
                        "minimum": 1
                    }
                },
                "required": [
                    "name"
                ]
            },
            "McpApiKey": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "prefix": {
                        "type": "string",
                        "maxLength": 40
                    },
                    "last_four": {
                        "type": "string",
                        "maxLength": 8
                    },
                    "status": {
                        "enum": [
                            "active",
                            "revoked"
                        ],
                        "type": "string",
                        "description": "* `active` - Active\n* `revoked` - Revoked",
                        "x-spec-enum-id": "37f156c83b1a8478"
                    },
                    "rate_limit_per_minute": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "last_used_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "revoked_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "metadata": {},
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "id",
                    "last_four",
                    "name",
                    "prefix",
                    "updated_at"
                ]
            },
            "McpApiKeyRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "prefix": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "last_four": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8
                    },
                    "status": {
                        "enum": [
                            "active",
                            "revoked"
                        ],
                        "type": "string",
                        "description": "* `active` - Active\n* `revoked` - Revoked",
                        "x-spec-enum-id": "37f156c83b1a8478"
                    },
                    "rate_limit_per_minute": {
                        "type": "integer",
                        "maximum": 2147483647,
                        "minimum": 0
                    },
                    "last_used_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "revoked_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "metadata": {}
                },
                "required": [
                    "last_four",
                    "name",
                    "prefix"
                ]
            },
            "McpCheckoutRequest": {
                "type": "object",
                "properties": {
                    "pack_key": {
                        "enum": [
                            "test",
                            "starter",
                            "growth",
                            "scale"
                        ],
                        "type": "string",
                        "description": "* `test` - test\n* `starter` - starter\n* `growth` - growth\n* `scale` - scale",
                        "x-spec-enum-id": "e6faacedbd5be675",
                        "default": "starter"
                    },
                    "success_url": {
                        "type": "string",
                        "format": "uri",
                        "minLength": 1
                    },
                    "cancel_url": {
                        "type": "string",
                        "format": "uri",
                        "minLength": 1
                    }
                }
            },
            "McpSearchRequest": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 10
                    },
                    "live_search": {
                        "type": "boolean",
                        "default": false
                    },
                    "filters": {
                        "type": "object",
                        "additionalProperties": {}
                    },
                    "project_context": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "query"
                ]
            },
            "McpToolExecuteRequest": {
                "type": "object",
                "properties": {
                    "tool": {
                        "enum": [
                            "search_materials",
                            "get_product",
                            "find_alternatives",
                            "compare_products"
                        ],
                        "type": "string",
                        "description": "* `search_materials` - search_materials\n* `get_product` - get_product\n* `find_alternatives` - find_alternatives\n* `compare_products` - compare_products",
                        "x-spec-enum-id": "62a59e9eedf3d5ee"
                    },
                    "arguments": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "tool"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Use your Peeko MCP API key or OAuth-issued bearer token."
            }
        }
    },
    "servers": [
        {
            "url": "https://api.getpeeko.ai"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ]
}