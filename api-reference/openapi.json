{
    "openapi": "3.0.3",
    "info": {
        "title": "Peeko MCP API",
        "version": "0.1",
        "description": "Public API surface for Peeko Material Search MCP. Use a Peeko MCP bearer token to call JSON-RPC tools, search materials, and retrieve product data."
    },
    "paths": {
        "/api/v1/mcp/products/{product_id}": {
            "get": {
                "operationId": "products_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "product_id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true,
                        "description": "Product ID copied from `results[].id` in search_materials.",
                        "example": "3c90c3cc-0d44-4b50-8888-ddd25736052a"
                    }
                ],
                "tags": [
                    "MCP - Search"
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "data": {
                                        "id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                        "title": "City District Emerald Matte 2x10",
                                        "url": "https://example.com/products/city-district-emerald",
                                        "description": "A bright emerald ceramic subway tile suitable for interior walls.",
                                        "manufacturer": "Iris Ceramica",
                                        "sku": "CD-EM-2X10-MATTE",
                                        "vendor": "Tile Distributor Co.",
                                        "availability_status": "in_stock",
                                        "lead_time": "3-5 business days",
                                        "image_urls": [
                                            "https://example.com/images/city-district-emerald.jpg"
                                        ],
                                        "pricing": [
                                            { "price_type": "list", "price": "4.99", "currency": "USD" }
                                        ],
                                        "specifications": [
                                            { "type": "size", "value": "2x10", "unit": "in" },
                                            { "type": "finish", "value": "Matte", "unit": null },
                                            { "type": "dcof", "value": "0.42", "unit": null }
                                        ],
                                        "documents": [],
                                        "videos": []
                                    },
                                    "errors": [],
                                    "meta": {
                                        "version": "0.1.0",
                                        "app_name": "Peeko MCP"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Get product details",
                "description": "Retrieve full details for one Peeko product. Get the `product_id` from `results[].id` in a `search_materials` response."
            }
        },
        "/api/v1/mcp/products/alternatives": {
            "post": {
                "operationId": "products_alternatives_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            },
                            "examples": {
                                "Query-only alternatives": {
                                    "summary": "No product ID needed",
                                    "value": {
                                        "query": "brighter version of emerald subway tile",
                                        "limit": 5
                                    }
                                },
                                "Alternatives to a search result": {
                                    "summary": "Use a product ID returned by search",
                                    "value": {
                                        "product_id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                        "limit": 5
                                    }
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            },
                            "examples": {
                                "Query-only alternatives": {
                                    "summary": "No product ID needed",
                                    "value": {
                                        "query": "brighter version of emerald subway tile",
                                        "limit": 5
                                    }
                                },
                                "Alternatives to a search result": {
                                    "summary": "Use a product ID returned by search",
                                    "value": {
                                        "product_id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                        "limit": 5
                                    }
                                }
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            },
                            "examples": {
                                "Query-only alternatives": {
                                    "summary": "No product ID needed",
                                    "value": {
                                        "query": "brighter version of emerald subway tile",
                                        "limit": 5
                                    }
                                },
                                "Alternatives to a search result": {
                                    "summary": "Use a product ID returned by search",
                                    "value": {
                                        "product_id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                        "limit": 5
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "query": "brighter version of emerald subway tile",
                                    "results": [
                                        {
                                            "id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                            "title": "City District Emerald Matte 2x10",
                                            "manufacturer": "Iris Ceramica",
                                            "url": "https://example.com/products/city-district-emerald",
                                            "text": "A bright emerald ceramic subway tile suitable for interior walls.",
                                            "image_urls": [
                                                "https://example.com/images/city-district-emerald.jpg"
                                            ]
                                        }
                                    ],
                                    "metadata": {
                                        "results_count": 1
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Find alternative products",
                "description": "Find alternatives using either a natural-language `query` or a `product_id` from a previous search. For playground use, the easiest path is to enter only `query` and `limit`."
            }
        },
        "/api/v1/mcp/products/compare": {
            "post": {
                "operationId": "products_compare_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            },
                            "examples": {
                                "Compare two search results": {
                                    "summary": "Use IDs returned by search",
                                    "value": {
                                        "product_ids": [
                                            "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                            "4c90c3cc-0d44-4b50-8888-ddd25736052b"
                                        ]
                                    }
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            },
                            "examples": {
                                "Compare two search results": {
                                    "summary": "Use IDs returned by search",
                                    "value": {
                                        "product_ids": [
                                            "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                            "4c90c3cc-0d44-4b50-8888-ddd25736052b"
                                        ]
                                    }
                                }
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            },
                            "examples": {
                                "Compare two search results": {
                                    "summary": "Use IDs returned by search",
                                    "value": {
                                        "product_ids": [
                                            "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                            "4c90c3cc-0d44-4b50-8888-ddd25736052b"
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "data": {
                                        "products": [
                                            {
                                                "product_id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                                "title": "City District Emerald Matte 2x10",
                                                "url": "https://example.com/products/city-district-emerald",
                                                "manufacturer": "Iris Ceramica",
                                                "image_urls": ["https://example.com/images/city-district-emerald.jpg"],
                                                "availability_status": "in_stock",
                                                "sku": "CD-EM-2X10-MATTE",
                                                "best_price": { "price": "4.99", "currency": "USD" }
                                            },
                                            {
                                                "product_id": "4c90c3cc-0d44-4b50-8888-ddd25736052b",
                                                "title": "City District Cobalt Matte 2x10",
                                                "url": "https://example.com/products/city-district-cobalt",
                                                "manufacturer": "Iris Ceramica",
                                                "image_urls": [],
                                                "availability_status": "backorder",
                                                "sku": "CD-CO-2X10-MATTE",
                                                "best_price": { "price": "4.49", "currency": "USD" }
                                            }
                                        ],
                                        "spec_matrix": {
                                            "size": {
                                                "3c90c3cc-0d44-4b50-8888-ddd25736052a": "2x10 in",
                                                "4c90c3cc-0d44-4b50-8888-ddd25736052b": "2x10 in"
                                            },
                                            "dcof": {
                                                "3c90c3cc-0d44-4b50-8888-ddd25736052a": "0.42",
                                                "4c90c3cc-0d44-4b50-8888-ddd25736052b": "0.44"
                                            }
                                        },
                                        "missing_product_ids": []
                                    },
                                    "errors": [],
                                    "meta": {
                                        "version": "0.1.0",
                                        "app_name": "Peeko MCP"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Compare products by ID",
                "description": "Compare two to five products. Product IDs come from `results[].id` in `search_materials`; search first, copy the IDs you want to compare, then call this endpoint."
            }
        },
        "/api/v1/mcp/search/materials": {
            "post": {
                "operationId": "search_materials_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            },
                            "examples": {
                                "Basic material search": {
                                    "summary": "Search by product need",
                                    "value": {
                                        "query": "exterior porcelain tile dcof 0.42",
                                        "limit": 5,
                                        "live_search": false
                                    }
                                },
                                "Filtered search": {
                                    "summary": "Manufacturer + availability filter",
                                    "value": {
                                        "query": "exterior porcelain tile dcof 0.42",
                                        "limit": 5,
                                        "manufacturer": "Daltile",
                                        "availability_status": "in_stock",
                                        "min_score": 0.72
                                    }
                                },
                                "Live web search": {
                                    "summary": "Broader live discovery (3 credits)",
                                    "value": {
                                        "query": "bio-based resilient flooring for healthcare corridors",
                                        "limit": 5,
                                        "live_search": true
                                    }
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            },
                            "examples": {
                                "Basic material search": {
                                    "summary": "Search by product need",
                                    "value": {
                                        "query": "brighter version of emerald subway tile",
                                        "limit": 5,
                                        "live_search": false
                                    }
                                },
                                "Live web search": {
                                    "summary": "Broader live discovery",
                                    "value": {
                                        "query": "bio-based resilient flooring for healthcare corridors",
                                        "limit": 5,
                                        "live_search": true
                                    }
                                }
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            },
                            "examples": {
                                "Basic material search": {
                                    "summary": "Search by product need",
                                    "value": {
                                        "query": "brighter version of emerald subway tile",
                                        "limit": 5,
                                        "live_search": false
                                    }
                                },
                                "Live web search": {
                                    "summary": "Broader live discovery",
                                    "value": {
                                        "query": "bio-based resilient flooring for healthcare corridors",
                                        "limit": 5,
                                        "live_search": true
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "query": "exterior porcelain tile dcof 0.42",
                                    "results": [
                                        {
                                            "id": "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                                            "title": "City District Emerald Matte 2x10",
                                            "manufacturer": "Daltile",
                                            "url": "https://example.com/products/city-district-emerald",
                                            "text": "Exterior porcelain tile rated DCOF 0.42 for wet areas.",
                                            "image_urls": [
                                                "https://example.com/images/city-district-emerald.jpg"
                                            ],
                                            "availability_status": "in_stock"
                                        }
                                    ],
                                    "metadata": {
                                        "results_count": 1,
                                        "next_cursor": "eyJvZmZzZXQiOiA1fQ"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Search materials by natural language",
                "description": "Start here. Enter a natural-language material or product query and Peeko returns matching products. Use `results[].id` from this response as the `product_id` for product detail, alternatives, or compare requests."
            }
        },
        "/api/v1/mcp/server": {
            "post": {
                "operationId": "server_create",
                "description": "Transport endpoint used by Cursor and other MCP clients. Most developers should connect their MCP client to this URL rather than call it directly. To test search in the playground, use `POST /api/v1/mcp/search/materials`.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "format",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "event-stream",
                                "json"
                            ]
                        }
                    }
                ],
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "MCP JSON-RPC endpoint"
            }
        },
        "/api/v1/mcp/server/execute": {
            "post": {
                "operationId": "server_execute_create",
                "tags": [
                    "MCP - Server"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            },
                            "examples": {
                                "Execute search_materials": {
                                    "summary": "Run a search tool call",
                                    "value": {
                                        "tool": "search_materials",
                                        "arguments": {
                                            "query": "exterior porcelain tile DCOF 0.42",
                                            "limit": 3,
                                            "live_search": false
                                        }
                                    }
                                }
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            },
                            "examples": {
                                "Execute search_materials": {
                                    "summary": "Run a search tool call",
                                    "value": {
                                        "tool": "search_materials",
                                        "arguments": {
                                            "query": "exterior porcelain tile DCOF 0.42",
                                            "limit": 3,
                                            "live_search": false
                                        }
                                    }
                                }
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            },
                            "examples": {
                                "Execute search_materials": {
                                    "summary": "Run a search tool call",
                                    "value": {
                                        "tool": "search_materials",
                                        "arguments": {
                                            "query": "exterior porcelain tile DCOF 0.42",
                                            "limit": 3,
                                            "live_search": false
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Execute a Peeko MCP tool",
                "description": "Convenience endpoint for calling a Peeko MCP tool by name. Use `search_materials` first if you need product IDs for `get_product` or `compare_products`."
            }
        },
        "/api/v1/mcp/server/tools": {
            "get": {
                "operationId": "server_tools_retrieve",
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "data": {
                                        "tools": [
                                            {
                                                "name": "search_materials",
                                                "description": "Search construction materials and products"
                                            },
                                            {
                                                "name": "get_product",
                                                "description": "Get full details for a product"
                                            },
                                            {
                                                "name": "find_alternatives",
                                                "description": "Find alternatives"
                                            },
                                            {
                                                "name": "compare_products",
                                                "description": "Compare products"
                                            }
                                        ]
                                    },
                                    "errors": [],
                                    "meta": {
                                        "version": "0.1.0",
                                        "app_name": "Peeko MCP"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "List available MCP tools",
                "description": "Returns the Peeko MCP tools available to this API key."
            }
        },
        "/api/v1/mcp/whoami": {
            "get": {
                "operationId": "whoami_retrieve",
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                },
                                "example": {
                                    "success": true,
                                    "data": {
                                        "user_id": 123,
                                        "api_key_prefix": "pk_mcp_live",
                                        "subscription_status": "active",
                                        "credit_balance": 10
                                    },
                                    "errors": [],
                                    "meta": {
                                        "version": "0.1.0",
                                        "app_name": "Peeko MCP"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "summary": "Check the current MCP API key",
                "description": "Use this lightweight endpoint to verify that your bearer token works."
            }
        }
    },
    "components": {
        "schemas": {
            "AlternativesRequest": {
                "type": "object",
                "properties": {
                    "product_id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Optional. Copy this from `results[].id` in a search_materials response.",
                        "example": "3c90c3cc-0d44-4b50-8888-ddd25736052a"
                    },
                    "query": {
                        "type": "string",
                        "description": "Recommended in the playground. Use a natural-language alternatives query.",
                        "example": "brighter version of emerald subway tile"
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 5
                    },
                    "manufacturer": {
                        "type": "string",
                        "description": "Constrain alternatives to a specific manufacturer.",
                        "example": "Iris Ceramica"
                    }
                },
                "description": "Find alternatives by query or by a product ID returned from search_materials."
            },
            "CompareRequest": {
                "type": "object",
                "properties": {
                    "product_ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "maxItems": 5,
                        "minItems": 2,
                        "description": "Two to five product IDs copied from `results[].id` in search_materials.",
                        "example": [
                            "3c90c3cc-0d44-4b50-8888-ddd25736052a",
                            "4c90c3cc-0d44-4b50-8888-ddd25736052b"
                        ]
                    }
                },
                "required": [
                    "product_ids"
                ],
                "description": "Compare products returned by a previous material search."
            },
            "McpSearchRequest": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000,
                        "description": "Describe what you want to find.",
                        "example": "exterior porcelain tile dcof 0.42"
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 10,
                        "description": "Maximum results per page.",
                        "example": 5
                    },
                    "live_search": {
                        "type": "boolean",
                        "default": false,
                        "description": "Include live web discovery. Costs 3 credits instead of 1.",
                        "example": false
                    },
                    "manufacturer": {
                        "type": "string",
                        "description": "Case-insensitive exact manufacturer filter (e.g. \"Daltile\").",
                        "example": "Daltile"
                    },
                    "availability_status": {
                        "type": "string",
                        "enum": ["in_stock", "out_of_stock", "backorder", "discontinued", "available_on_request"],
                        "description": "Filter by product availability status.",
                        "example": "in_stock"
                    },
                    "min_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Cosine similarity floor (0–1). Higher values return fewer but more relevant results.",
                        "example": 0.72
                    },
                    "cursor": {
                        "type": "string",
                        "description": "Opaque pagination token from metadata.next_cursor. Pass to fetch the next page of the same query."
                    }
                },
                "required": [
                    "query"
                ],
                "description": "Natural-language material search request."
            },
            "McpToolExecuteRequest": {
                "type": "object",
                "properties": {
                    "tool": {
                        "enum": [
                            "search_materials",
                            "get_product",
                            "find_alternatives",
                            "compare_products"
                        ],
                        "type": "string",
                        "description": "Tool to execute. Start with `search_materials` for discovery.",
                        "x-spec-enum-id": "62a59e9eedf3d5ee"
                    },
                    "arguments": {
                        "type": "object",
                        "additionalProperties": {},
                        "description": "JSON arguments for the selected MCP tool.",
                        "example": {
                            "query": "exterior porcelain tile DCOF 0.42",
                            "limit": 3,
                            "live_search": false
                        }
                    }
                },
                "required": [
                    "tool"
                ],
                "description": "Call a Peeko MCP tool by name with JSON arguments."
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Use your Peeko MCP API key or OAuth-issued bearer token."
            }
        }
    },
    "servers": [
        {
            "url": "https://api.getpeeko.ai"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
