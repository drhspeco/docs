{
    "openapi": "3.0.3",
    "info": {
        "title": "Peeko MCP API",
        "version": "0.1",
        "description": "Public API surface for Peeko Material Search MCP. Use a Peeko MCP bearer token to call JSON-RPC tools, search materials, and retrieve product data."
    },
    "paths": {
        "/api/v1/mcp/products/{product_id}": {
            "get": {
                "operationId": "products_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "product_id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "required": true
                    }
                ],
                "tags": [
                    "MCP - Search"
                ],
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/products/alternatives": {
            "post": {
                "operationId": "products_alternatives_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/AlternativesRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/products/compare": {
            "post": {
                "operationId": "products_compare_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CompareRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/search/materials": {
            "post": {
                "operationId": "search_materials_create",
                "tags": [
                    "MCP - Search"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/McpSearchRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/server": {
            "post": {
                "operationId": "server_create",
                "description": "MCP Streamable HTTP transport endpoint.\n\nImplements the subset Cursor uses: single-shot POST returning JSON,\noptional `Mcp-Session-Id` echo, and 405 for GET/DELETE so clients fall\nback to non-streaming mode without retrying.",
                "parameters": [
                    {
                        "in": "query",
                        "name": "format",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "event-stream",
                                "json"
                            ]
                        }
                    }
                ],
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/server/execute": {
            "post": {
                "operationId": "server_execute_create",
                "tags": [
                    "MCP - Server"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/McpToolExecuteRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/server/tools": {
            "get": {
                "operationId": "server_tools_retrieve",
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/mcp/whoami": {
            "get": {
                "operationId": "whoami_retrieve",
                "tags": [
                    "MCP - Server"
                ],
                "responses": {
                    "200": {
                        "description": "No response body"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "AlternativesRequest": {
                "type": "object",
                "properties": {
                    "product_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "query": {
                        "type": "string"
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 5
                    }
                }
            },
            "CompareRequest": {
                "type": "object",
                "properties": {
                    "product_ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "maxItems": 5,
                        "minItems": 2
                    }
                },
                "required": [
                    "product_ids"
                ]
            },
            "McpSearchRequest": {
                "type": "object",
                "properties": {
                    "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 5000
                    },
                    "limit": {
                        "type": "integer",
                        "maximum": 20,
                        "minimum": 1,
                        "default": 10
                    },
                    "live_search": {
                        "type": "boolean",
                        "default": false
                    },
                    "filters": {
                        "type": "object",
                        "additionalProperties": {}
                    },
                    "project_context": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "query"
                ]
            },
            "McpToolExecuteRequest": {
                "type": "object",
                "properties": {
                    "tool": {
                        "enum": [
                            "search_materials",
                            "get_product",
                            "find_alternatives",
                            "compare_products"
                        ],
                        "type": "string",
                        "description": "* `search_materials` - search_materials\n* `get_product` - get_product\n* `find_alternatives` - find_alternatives\n* `compare_products` - compare_products",
                        "x-spec-enum-id": "62a59e9eedf3d5ee"
                    },
                    "arguments": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "tool"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Use your Peeko MCP API key or OAuth-issued bearer token."
            }
        }
    },
    "servers": [
        {
            "url": "https://api.getpeeko.ai"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ]
}