{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Peeko Docs",
  "theme": "almond",
  "logo": {
    "light": "https://media.brand.dev/b7eecca6-40ef-4d9e-b4cb-43dcd3574be6.png",
    "dark": "https://media.brand.dev/b7eecca6-40ef-4d9e-b4cb-43dcd3574be6.png"
  },
  "favicon": "https://media.brand.dev/b7eecca6-40ef-4d9e-b4cb-43dcd3574be6.png",
  "colors": {
    "primary": "#5b6354",
    "light": "#215333"
  },
  "topbar": {
    "style": "announcement",
    "announcement": {
      "text": "May 17: search filters, cursor pagination, richer product detail, and spec matrix comparison. [See changelog →](/mcp/changelog)"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@getpeeko.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Go to App",
      "href": "https://app.getpeeko.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Peeko MCP",
            "pages": [
              "introduction",
              "mcp/developer-quickstart",
              "mcp/authentication",
              "mcp/tools",
              "mcp/billing",
              "mcp/rate-limits-and-errors",
              "mcp/response-schemas",
              "mcp/rag-vs-live-search",
              "mcp/changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "MCP REST API",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "typescript"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "footer": {
    "socials": {
      "website": "https://www.getpeeko.ai"
    }
  }
}
